// Etta's design tokens: every colour, size and radius a panel uses has a name
// here, so no panel writes a literal. The ball's own colours stay in
// common/palette.plm (ink, mint, coal…): those are hers, and these are what
// surrounds her.
//
// Type: Geist, in four weights (400, 500, 600 and 300 for the big time). The
// family is written on every text —pleamar takes it as a literal only—; what
// is shared here is the scale.

library Tokens {
    //  Surfaces, from her body up: a plate on a panel, what lifts under the
    //  pointer, and a track or a pressed thing.
    let tk.body = #151616
    let tk.s1 = #1d1f20
    let tk.s2 = #26292b
    let tk.s3 = #313537
    let tk.line = #ffffff               // drawn at 7 %

    //  Ink: what is read, what is secondary, what is a caption. All three
    //  pass 4.5:1 on tk.s1.
    let tk.ink = #f3f5f4
    let tk.ink2 = #b9bfbc
    let tk.ink3 = #8d9491

    //  The accents, and what each one means.
    let tk.mint = #9ed6bd               // on, focus: the house
    let tk.mint_hi = #b2e0cb
    let tk.mint_ink = #0e2a1f           // text on mint
    let tk.mint_soft = #1f2c27          // a mint-tinted plate
    let tk.sand = #e8c07a               // warning, low, urgent
    let tk.sand_soft = #2c261c
    let tk.red = #ef6b5e                // error, danger, wrong password
    let tk.red_soft = #33201e
    let tk.red_ink = #2a0b07
    let tk.blue = #86b6f2               // messages
    let tk.violet = #b5a0f2             // work, mail

    //  The type scale. Nothing smaller than 12.
    let tk.t.display = 96
    let tk.t.time = 44
    let tk.t.num = 28
    let tk.t.title = 20
    let tk.t.head = 15
    let tk.t.body = 14
    let tk.t.label = 13
    let tk.t.cap = 12

    //  Radii.
    let tk.r.panel = 24
    let tk.r.card = 16
    let tk.r.ctl = 12
    let tk.r.chip = 8

    //  A text field (the prototypes' `.field`): 44 tall, 12 in from its
    //  edges, and with an icon the text starts at 40 (12, the icon's 18 and a
    //  gap of 10). An `input` takes no anchor: its `at` is its TOP left
    //  corner, and its line is 1.3 times its size. Written at the middle of
    //  its box, as every field once was, the text sat half a line low. So a
    //  field's input goes half a line above the middle: these, by size.
    let tk.field.h = 44
    let tk.field.pad = 12
    let tk.field.text = 40
    let tk.mid.s13 = 8.45
    let tk.mid.s14 = 9.1
    let tk.mid.s16 = 10.4
    let tk.mid.s24 = 15.6
}
