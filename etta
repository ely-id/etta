#!/bin/sh
# etta: start her and talk to her from outside. It is what the
# compositor's keyboard shortcuts use.
#
#   etta start [pleamar options]      starts her up (autostart)
#   etta stop                         closes her
#   etta status                       whether she is running, and what she says of herself
#   etta report [--seconds N]         measures her (and the desktop's scenes) while you use
#                                      it, and writes a report to send when something stutters
#   etta <event>                      tells her something: search, lock,
#                                      shot_region, shot_screen,
#                                      shot_window, record_toggle, celebrate,
#                                      rage, adventure, volume_up, volume_down,
#                                      mute_output, mute_mic, bright_up,
#                                      bright_down, play_pause, next, previous…
# (Through the link the installer leaves in ~/.local/bin too: where she really is.)
HERE="$(dirname "$(readlink -f "$0")")"
# The pleamar installed, or the one built next to her.
PLEAMAR="${PLEAMAR:-$(command -v pleamar 2> /dev/null || echo "$HOME/Proyectos/pleamar/target/release/pleamar")}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/etta"
# Deriva's library (what is dropped on her, kept and found again) lives in her
# folder: `deriva/`, built there. Hers goes first on the PATH.
DERIVA="$HERE/deriva/target/release"
HALLEY_ADAPTER="$HERE/halley/target/release"
# The field shaders' thumbnails, for the Wallpaper page on Halley.
SHADER_THUMB="$HERE/tools/shader-thumb/target/release"
PATH="$HALLEY_ADAPTER:$SHADER_THUMB:$DERIVA:$PATH"
# Where she lives, for the logic: her own wallpapers are in it.
ETTA_DIR="$HERE"
export PATH ETTA_DIR

# Only Halley needs the SDK adapter. Other compositors keep Pleamar's services.
build_halley() {
    case ":${XDG_CURRENT_DESKTOP:-}:" in
        *:Halley:*|*:halley:*) ;;
        *) return 0 ;;
    esac
    if [ -x "$HALLEY_ADAPTER/etta-halley" ]; then
        [ -z "$(find "$HERE/halley/src" "$HERE/halley/Cargo.toml" "$HERE/halley/Cargo.lock" -newer "$HALLEY_ADAPTER/etta-halley" 2> /dev/null)" ] && return 0
    elif command -v etta-halley > /dev/null 2>&1; then
        return 0
    fi
    if [ -w "$HERE/halley" ] && command -v cargo > /dev/null 2>&1; then
        (cd "$HERE/halley" && cargo build --release --locked > "$STATE_DIR/halley-build.log" 2>&1) && return 0
    fi
    echo "Etta: Halley's adapter is unavailable; see $STATE_DIR/halley-build.log or build halley/Cargo.toml." >&2
}

# The thumbnails' painter, on Halley only, built like the adapter.
build_shader_thumb() {
    case ":${XDG_CURRENT_DESKTOP:-}:" in
        *:Halley:*|*:halley:*) ;;
        *) return 0 ;;
    esac
    T="$HERE/tools/shader-thumb"
    if [ -x "$SHADER_THUMB/etta-shader-thumb" ] && [ -z "$(find "$T/src" "$T/Cargo.toml" -newer "$SHADER_THUMB/etta-shader-thumb" 2> /dev/null)" ]; then
        return 0
    fi
    [ -w "$T" ] && command -v cargo > /dev/null 2>&1 || return 0
    (cd "$T" && nice -n 10 cargo build --release > "$STATE_DIR/shader-thumb-build.log" 2>&1) &
}

# Built the first time she starts, and again when its source changes (after an
# update), if there is Rust to build it with. Meanwhile she starts as ever;
# only Deriva's page waits for it. Not where her folder cannot be written
# (Nix brings it already built).
build_deriva() {
    [ -f "$HERE/deriva/Cargo.toml" ] && [ -w "$HERE/deriva" ] || return 0
    command -v cargo > /dev/null 2>&1 || return 0
    if [ -x "$DERIVA/deriva-worker" ] && [ -z "$(find "$HERE/deriva/src" "$HERE/deriva/Cargo.toml" "$HERE/deriva/Cargo.lock" -newer "$DERIVA/deriva-worker" 2> /dev/null)" ]; then
        return 0
    fi
    (cd "$HERE/deriva" && nice -n 10 cargo build --release --locked > "$STATE_DIR/deriva-build.log" 2>&1) &
}

case "${1:-}" in
    start)
        shift
        mkdir -p "$STATE_DIR"
        cd "$HERE" || exit 1
        # The previous run's log is kept once and no more: so that it does not
        # grow forever, but yesterday's can still be looked at.
        [ -f "$STATE_DIR/etta.log" ] && mv -f "$STATE_DIR/etta.log" "$STATE_DIR/etta.log.1"
        build_halley
        build_shader_thumb
        build_deriva
        exec "$PLEAMAR" --scene etta.plm --no-hud --stall 0 "$@" > "$STATE_DIR/etta.log" 2>&1
        ;;
    stop)
        exec "$PLEAMAR" --say etta quit
        ;;
    report)
        shift
        exec "$PLEAMAR" --report "$@"
        ;;
    status)
        if "$PLEAMAR" --say etta "get open" > /dev/null 2>&1; then
            echo "running · log in $STATE_DIR/etta.log"
        else
            echo "stopped"; exit 1
        fi
        ;;
    ""|-h|--help|help)
        sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        exec "$PLEAMAR" --say etta "emit $1"
        ;;
esac
